title CIVITA 1.1.742 · Contenedor, contrato y adaptadores

interface ReportRepository {
 + signIn(): String {suspend}
 + loadConfig(): AppConfig {suspend}
 + observeCategories(): Flow<RepositorySnapshot<IncidentCategory>>
 + observeReports(): Flow<RepositorySnapshot<UrbanReport>>
 + publishReport(draft: ReportDraft, requestId: String): String {suspend}
}
class FirebaseReportRepository {
 + FirebaseReportRepository(auth: FirebaseAuth, firestore: FirebaseFirestore)
 - auth: FirebaseAuth
 - firestore: FirebaseFirestore
 + signIn(): String {suspend}
 + loadConfig(): AppConfig {suspend}
 + observeCategories(): Flow<RepositorySnapshot<IncidentCategory>>
 + observeReports(): Flow<RepositorySnapshot<UrbanReport>>
 + publishReport(draft: ReportDraft, requestId: String): String {suspend}
 - requiredString(field: String): String {extension DocumentSnapshot}
 - requiredLong(field: String): Long {extension DocumentSnapshot}
 - parseColor(value: String): Color
}
class AppContainer {
 - app: FirebaseApp?
 - auth: FirebaseAuth?
 - db: FirebaseFirestore?
 - storage: FirebaseStorage?
 + repository: ReportRepository?
 + authRepository: AuthRepository?
 + communityRepository: CommunityRepository?
 + AppContainer(context: Context)
}
