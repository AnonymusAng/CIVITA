class ViewModel <<AndroidX>>
CivitaViewModel --|> ViewModel
CommunityViewModel --|> ViewModel
CommunityViewModel ..|> CommunityActions
CivitaViewModel --> "1" ReportRepository
CommunityViewModel --> "1" CommunityRepository
CommunityViewModel ..> CommunityUiState
