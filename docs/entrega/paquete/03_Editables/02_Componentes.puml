@startuml
left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam linetype ortho
title CIVITA · Componentes
actor Usuario
package "Cliente Android: una APK / módulo :app" {
 component "Interfaz de usuario / View\nJetpack Compose · CivitaApp()" as UI {
  component "Acceso\nAuthScreen()" as Access
  component "Mapa\nMapScreen()" as Map
  component "Publicación\nReportScreen()" as Publish
  component "Comunidad\nCommunityScreen()" as Community
  component "Detalle\nReportDetailScreen()" as Detail
  component "Cuenta\nProfileScreen() / PreferencesScreen()" as Profile
 }
 component "Coordinación MVVM\nAuthViewModel / CivitaViewModel / CommunityViewModel" as VM
 component "Repositorios\nAuthRepository / FirebaseReportRepository / CommunityRepository" as Data
 component "Composición / DI\nCivitaApp + AppContainer + fábricas" as DI
 component "SDK Firebase Android\nAuth / Firestore / Storage" as SDK
 component "Credential Manager\nGoogle ID" as Google
 interface "I1: CommunityActions" as Actions
 interface "I2: ReportRepository" as Reports
 UI ..> VM : observa StateFlow y envía acciones
 UI ..> Actions : use
 VM -- Actions : proporciona
 VM ..> Reports : use
 Data -- Reports : proporciona
 VM ..> Data : AuthRepository / CommunityRepository
 DI ..> VM : create / suministra
 DI ..> Data : create
 Data ..> SDK : use
 Data ..> Google : google()
}
Usuario -- UI : usa
package "Firebase: servicios externos (BaaS)" {
 component Authentication as Auth
 component "Cloud Firestore" as DB
 component "Cloud Storage" as Store
 artifact firestore.rules as Rules
 artifact storage.rules as SRules
}
SDK ..> Auth : identidad y sesión
SDK ..> DB : datos y transacciones
SDK ..> Store : archivos
Rules ..> DB : autoriza
SRules ..> Store : autoriza
SRules ..> DB : consulta autor y contador
@enduml
